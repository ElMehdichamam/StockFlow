# StockFlow backend — copy to .env and fill in real values. Never commit .env.

# Port the Express server listens on (positive integer)
PORT=5000

# development | test | production
NODE_ENV=development

# MongoDB connection string (Atlas M0 per the approved contract, or a local
# single-node replica set). Provide real credentials only in .env — never here.
MONGODB_URI=

# Allowed frontend origin, used later for CORS/CSRF checks (auth integration)
FRONTEND_ORIGIN=http://localhost:5173
